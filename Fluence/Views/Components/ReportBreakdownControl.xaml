<UserControl
    x:Class="Fluence.Views.Components.ReportBreakdownControl"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,0,0,30">
        <TextBlock x:Name="HeaderLabel"
                   Text="{Binding Header, ElementName=root}"
                   Foreground="{ThemeResource SystemColorControlAccentBrush}"
                   FontSize="18"
                   Margin="0,0,0,10"
                   Visibility="{Binding Header, ElementName=root, Converter={StaticResource StringToVisibilityConverter}}" />
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="20" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                            <TextBlock Grid.Column="1" Text="{Binding TransactionCount}" FontSize="16" Margin="10,4,0,0" Opacity="0.6" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Amount, ConverterParameter='N2'}" FontSize="24" FontWeight="SemiBold" IsHitTestVisible="False" />
                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Value="{Binding Percentage}" Foreground="{Binding Color}" Height="4" Margin="0,8,0,0" IsHitTestVisible="False" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
