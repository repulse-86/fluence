<UserControl
    x:Class="Fluence.Views.Components.ReportSpendingPatternsControl"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Header, ElementName=root}" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
        <TextBlock Grid.Row="1" FontSize="16" TextWrapping="Wrap" Margin="0,5,0,0" IsHitTestVisible="False">
            <Run Text="you spend most on " /><Run Text="{Binding MostSpentDay}" FontWeight="SemiBold" Foreground="{ThemeResource SystemColorControlAccentBrush}" /><Run Text=" while "/><Run Text="{Binding MostSpentMonth}" FontWeight="SemiBold" Foreground="{ThemeResource SystemColorControlAccentBrush}" /><Run Text=" was your highest spending month" />
        </TextBlock>
        <TextBlock Grid.Row="2" Text="suggested: try reducing weekend spending to increase runway." FontSize="14" Opacity="0.6" FontStyle="Italic" TextWrapping="Wrap" IsHitTestVisible="False" />
    </Grid>
</UserControl>
