<UserControl
    x:Class="Fluence.Views.Components.ReportDistributionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Fluence.Converters">

    <UserControl.Resources>
        <converters:WidthConverter x:Key="WidthConverter" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,30">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Background="#33FFFFFF" Height="30" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Rectangle Fill="{Binding Color}" Width="{Binding Percentage, Converter={StaticResource WidthConverter}, ConverterParameter=340}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
