<Page
    x:Name="pageRoot"
    x:Class="Fluence.HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Fluence.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <CommonNavigationTransitionInfo IsStaggeringEnabled="True"/>
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedTransactionsSource" 
                              Source="{Binding DefaultViewModel.HubViewModel.GroupedTransactions, ElementName=pageRoot}" 
                              IsSourceGrouped="True" />
    </Page.Resources>

    <Grid>
        <Hub x:Name="hub" Header="fluence">
            <Hub.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{ThemeResource HeaderTextBlockStyle}" FontSize="120" FontWeight="Bold" Margin="0,0,0,20"/>
                </DataTemplate>
            </Hub.HeaderTemplate>

            <HubSection Width="360">
                <HubSection.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="overview" FontSize="56" FontWeight="SemiLight" />
                    </DataTemplate>
                </HubSection.HeaderTemplate>
                <DataTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,16" DataContext="{Binding DefaultViewModel.HubViewModel, ElementName=pageRoot}">
                            
                            <TextBlock Text="current balance" FontSize="18" Opacity="0.6" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding CurrentBalance, ConverterParameter='N2'}" FontSize="72" FontWeight="Bold" Margin="0,0,0,20" />

                            <TextBlock Text="budget health" FontSize="18" Opacity="0.6" Margin="0,0,0,5" />
                            <ProgressBar Value="{Binding BudgetPercent}" Foreground="{Binding BudgetBrush}" Height="10" Margin="0,0,0,30" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="150" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#1AFFFFFF" Margin="0,0,5,5" Padding="15">
                                    <Grid>
                                        <TextBlock Text="daily allowance" FontSize="14" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding DailyAllowance, ConverterParameter='N2'}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="#1AFFFFFF" Margin="5,0,0,5" Padding="15">
                                    <Grid>
                                        <TextBlock Text="spent today" FontSize="14" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding SpentToday, ConverterParameter='N2'}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="#1AFFFFFF" Margin="0,5,5,0" Padding="15">
                                    <Grid>
                                        <TextBlock Text="weekly total" FontSize="14" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding WeeklyTotal, ConverterParameter='N2'}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="#1AFFFFFF" Margin="5,5,0,0" Padding="15">
                                    <Grid>
                                        <TextBlock Text="top category" FontSize="14" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding TopCategory}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </HubSection>

            <HubSection Width="360">
                <HubSection.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="history" FontSize="56" FontWeight="SemiLight" />
                    </DataTemplate>
                </HubSection.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <ListView ItemsSource="{Binding Source={StaticResource GroupedTransactionsSource}}"
                                  HorizontalContentAlignment="Stretch"
                                  IsItemClickEnabled="True"
                                  ItemClick="TransactionList_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding DateKey}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource SystemColorControlAccentBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,0.5" Padding="0,0,0,10" Margin="0,0,0,10"
                                            Background="Transparent" Holding="TransactionBorder_Holding">
                                        <FlyoutBase.AttachedFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="edit" Click="EditTransaction_Click" />
                                                <MenuFlyoutItem Text="delete" Click="DeleteTransaction_Click" />
                                            </MenuFlyout>
                                        </FlyoutBase.AttachedFlyout>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding DisplayTime}" 
                                                       FontSize="14" Opacity="0.4" Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                                       Text="{Binding CategoryName}" 
                                                       FontSize="24" FontWeight="SemiBold" />

                                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                                       Text="{Binding DisplayAmount}" 
                                                       Foreground="{Binding TypeBrush}" 
                                                       FontSize="20" FontWeight="Thin"
                                                       VerticalAlignment="Center" 
                                                       Margin="10,0,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Note}" 
                                                       FontSize="16" Opacity="0.8" Margin="0,8,0,0"
                                                       Visibility="{Binding NoteVisibility}" 
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </DataTemplate>
            </HubSection>

            <HubSection Width="360">
                <HubSection.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="reports" FontSize="56" FontWeight="SemiLight" />
                    </DataTemplate>
                </HubSection.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Pivot x:Name="ReportsPivot" Margin="-10,0,0,0">
                            <Pivot.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="24" FontWeight="SemiBold" Margin="0,0,20,0" />
                                </DataTemplate>
                            </Pivot.HeaderTemplate>

                            <PivotItem Header="day" DataContext="{Binding DefaultViewModel.HubViewModel.DayReport, ElementName=pageRoot}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                    <StackPanel Margin="0,0,10,30">
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="savings rate" FontSize="12" Opacity="0.6" />
                                                <TextBlock Text="{Binding SavingsRate, ConverterParameter='N0'}" FontSize="28" FontWeight="Bold">
                                                    <Run Text="%" FontSize="14" />
                                                </TextBlock>
                                                <ProgressBar Value="{Binding SavingsRate}" Foreground="#2ECC71" Height="4" Margin="0,5,20,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="vs yesterday" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TrendDirection}" FontSize="18" Margin="0,5,5,0" />
                                                    <TextBlock Text="{Binding TrendPercent, ConverterParameter='N0'}" FontSize="28" FontWeight="Bold">
                                                        <Run Text="%" FontSize="14" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="distribution" FontSize="18" Opacity="0.6" Margin="0,0,0,10" />
                                        <Border Height="30" CornerRadius="15" Background="#1AFFFFFF" Margin="0,0,0,30">
                                            <ItemsControl ItemsSource="{Binding Distribution}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Fill="{Binding Color}" Width="{Binding Percentage, Converter={StaticResource WidthConverter}, ConverterParameter=340}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <TextBlock Text="top budget burners" FontSize="18" Opacity="0.6" Margin="0,0,0,15" />
                                        <ItemsControl ItemsSource="{Binding BudgetBurners}" Margin="0,0,0,30">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="+" FontSize="14" Opacity="0.6" Margin="0,2,2,0" />
                                                            <TextBlock Text="{Binding Trend, ConverterParameter='N0'}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" />
                                                            <TextBlock Text="%" FontSize="12" Opacity="0.6" Margin="2,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="period flow" FontSize="18" Opacity="0.6" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="in" FontSize="12" Opacity="0.6" />
                                                <ProgressBar Value="{Binding FlowInPercent}" Foreground="#2ECC71" Height="6" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding FlowIn, ConverterParameter='N2'}" FontSize="20" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="out" FontSize="12" Opacity="0.6" />
                                                <ProgressBar Value="{Binding FlowOutPercent}" Foreground="#E74C3C" Height="6" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding FlowOut, ConverterParameter='N2'}" FontSize="20" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="breakdown" FontSize="18" Opacity="0.6" Margin="0,0,0,15" />
                                        <ItemsControl ItemsSource="{Binding Distribution}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,15">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" />
                                                            <TextBlock Text="{Binding TransactionCount}" FontSize="12" Opacity="0.4" Margin="10,3,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Amount, ConverterParameter='N2'}" FontSize="16" FontWeight="SemiBold" />
                                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Value="{Binding Percentage}" Foreground="{Binding Color}" Height="4" Margin="0,5,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>

                            <PivotItem Header="month" DataContext="{Binding DefaultViewModel.HubViewModel.MonthReport, ElementName=pageRoot}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                    <StackPanel Margin="0,0,10,30">
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="savings rate" FontSize="12" Opacity="0.6" />
                                                <TextBlock Text="{Binding SavingsRate, ConverterParameter='N0'}" FontSize="28" FontWeight="Bold">
                                                    <Run Text="%" FontSize="14" />
                                                </TextBlock>
                                                <ProgressBar Value="{Binding SavingsRate}" Foreground="#2ECC71" Height="4" Margin="0,5,20,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="vs last month" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TrendDirection}" FontSize="18" Margin="0,5,5,0" />
                                                    <TextBlock Text="{Binding TrendPercent, ConverterParameter='N0'}" FontSize="28" FontWeight="Bold">
                                                        <Run Text="%" FontSize="14" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="distribution" FontSize="18" Opacity="0.6" Margin="0,0,0,10" />
                                        <Border Height="30" CornerRadius="15" Background="#1AFFFFFF" Margin="0,0,0,15">
                                            <ItemsControl ItemsSource="{Binding Distribution}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Fill="{Binding Color}" Width="{Binding Percentage, Converter={StaticResource WidthConverter}, ConverterParameter=340}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <TextBlock Text="spending intensity" FontSize="12" Opacity="0.4" HorizontalAlignment="Right" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding IntensityMap}" Margin="0,0,0,30">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="16" VerticalChildrenAlignment="Top" HorizontalChildrenAlignment="Left" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="18" Height="18" Background="#2ECC71" Opacity="{Binding Intensity}" Margin="1" CornerRadius="2" ToolTipService.ToolTip="{Binding Label}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="top budget burners" FontSize="18" Opacity="0.6" Margin="0,0,0,15" />
                                        <ItemsControl ItemsSource="{Binding BudgetBurners}" Margin="0,0,0,30">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="+" FontSize="14" Opacity="0.6" Margin="0,2,2,0" />
                                                            <TextBlock Text="{Binding Trend, ConverterParameter='N0'}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" />
                                                            <TextBlock Text="%" FontSize="12" Opacity="0.6" Margin="2,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="month flow" FontSize="18" Opacity="0.6" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="in" FontSize="12" Opacity="0.6" />
                                                <ProgressBar Value="{Binding FlowInPercent}" Foreground="#2ECC71" Height="6" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding FlowIn, ConverterParameter='N2'}" FontSize="20" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="out" FontSize="12" Opacity="0.6" />
                                                <ProgressBar Value="{Binding FlowOutPercent}" Foreground="#E74C3C" Height="6" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding FlowOut, ConverterParameter='N2'}" FontSize="20" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#0DFFFFFF" Padding="15" Margin="0,0,0,30" CornerRadius="5">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="daily average" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DailyAverage, ConverterParameter='N2'}" FontSize="18" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="projected total" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ProjectedTotal, ConverterParameter='N2'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="breakdown" FontSize="18" Opacity="0.6" Margin="0,0,0,15" />
                                        <ItemsControl ItemsSource="{Binding Distribution}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,15">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" />
                                                            <TextBlock Text="{Binding TransactionCount}" FontSize="12" Opacity="0.4" Margin="10,3,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Amount, ConverterParameter='N2'}" FontSize="16" FontWeight="SemiBold" />
                                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Value="{Binding Percentage}" Foreground="{Binding Color}" Height="4" Margin="0,5,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>

                            <PivotItem Header="year" DataContext="{Binding DefaultViewModel.HubViewModel.YearReport, ElementName=pageRoot}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                    <StackPanel Margin="0,0,10,30">
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="savings rate" FontSize="12" Opacity="0.6" />
                                                <TextBlock Text="{Binding SavingsRate, ConverterParameter='N0'}" FontSize="28" FontWeight="Bold">
                                                    <Run Text="%" FontSize="14" />
                                                </TextBlock>
                                                <ProgressBar Value="{Binding SavingsRate}" Foreground="#2ECC71" Height="4" Margin="0,5,20,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="vs last year" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TrendDirection}" FontSize="18" Margin="0,5,5,0" />
                                                    <TextBlock Text="{Binding TrendPercent, ConverterParameter='N0'}" FontSize="28" FontWeight="Bold">
                                                        <Run Text="%" FontSize="14" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="distribution" FontSize="18" Opacity="0.6" Margin="0,0,0,10" />
                                        <Border Height="30" CornerRadius="15" Background="#1AFFFFFF" Margin="0,0,0,15">
                                            <ItemsControl ItemsSource="{Binding Distribution}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Fill="{Binding Color}" Width="{Binding Percentage, Converter={StaticResource WidthConverter}, ConverterParameter=340}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <TextBlock Text="monthly intensity" FontSize="12" Opacity="0.4" HorizontalAlignment="Right" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding IntensityMap}" Margin="0,0,0,30">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,0">
                                                        <Border Width="24" Height="24" Background="#2ECC71" Opacity="{Binding Intensity}" CornerRadius="4" />
                                                        <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.4" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="top budget burners" FontSize="18" Opacity="0.6" Margin="0,0,0,15" />
                                        <ItemsControl ItemsSource="{Binding BudgetBurners}" Margin="0,0,0,30">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="+" FontSize="14" Opacity="0.6" Margin="0,2,2,0" />
                                                            <TextBlock Text="{Binding Trend, ConverterParameter='N0'}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" />
                                                            <TextBlock Text="%" FontSize="12" Opacity="0.6" Margin="2,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="period flow" FontSize="18" Opacity="0.6" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="in" FontSize="12" Opacity="0.6" />
                                                <ProgressBar Value="{Binding FlowInPercent}" Foreground="#2ECC71" Height="6" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding FlowIn, ConverterParameter='N2'}" FontSize="20" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="out" FontSize="12" Opacity="0.6" />
                                                <ProgressBar Value="{Binding FlowOutPercent}" Foreground="#E74C3C" Height="6" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding FlowOut, ConverterParameter='N2'}" FontSize="20" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#0DFFFFFF" Padding="15" Margin="0,0,0,30" CornerRadius="5">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="monthly average" FontSize="12" Opacity="0.6" />
                                                    <TextBlock Text="{Binding DailyAverage, ConverterParameter='N2'}" FontSize="18" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="projected year" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ProjectedTotal, ConverterParameter='N2'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="breakdown" FontSize="18" Opacity="0.6" Margin="0,0,0,15" />
                                        <ItemsControl ItemsSource="{Binding Distribution}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,15">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" />
                                                            <TextBlock Text="{Binding TransactionCount}" FontSize="12" Opacity="0.4" Margin="10,3,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Amount, ConverterParameter='N2'}" FontSize="16" FontWeight="SemiBold" />
                                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Value="{Binding Percentage}" Foreground="{Binding Color}" Height="4" Margin="0,5,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>
                        </Pivot>
                    </Grid>
                </DataTemplate>
            </HubSection>
        </Hub>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="AddCategoryAppBarButton" Label="category" Icon="Bookmarks" Click="AddCategoryAppBarButton_Click" />
            <AppBarButton x:Name="QuickAddAppBarButton" Label="quick add" Icon="Add" Click="QuickAddAppBarButton_Click" />
            <AppBarButton x:Name="EditProfileAppBarButton" Label="profile" Icon="Account" Click="EditProfileAppBarButton_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
