<Page
    x:Class="Fluence.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluence.Views"
    xmlns:components="using:Fluence.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="REPORTS"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Margin="19,10,0,0"
                   FontSize="16" />

        <Pivot x:Name="ReportsPivot" Grid.Row="1" Margin="0,-36,0,0">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="56" FontWeight="SemiLight" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <PivotItem Header="today" DataContext="{Binding DayReport}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,20,19,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="spending" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
                        <components:ReportDistributionControl Grid.Row="1" DataContext="{Binding Distribution}" />
                        <components:ReportBurnersControl Grid.Row="2" DataContext="{Binding BudgetBurners}" />
                        <components:ReportBreakdownControl Grid.Row="3" DataContext="{Binding Distribution}" />

                        <Rectangle Grid.Row="4" Height="1" Fill="Gray" Margin="0,0,0,40" IsHitTestVisible="False" />

                        <components:ReportComparisonControl Grid.Row="5" Header="comparison" TrendText="vs yesterday" ShowProjections="False" />
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="month" DataContext="{Binding MonthReport}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,20,19,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="activity" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
                        <components:ReportWeekdayControl Grid.Row="1" Header="weekday" DataContext="{Binding WeekdaySpending}" />
                        <components:ReportIntensityControl Grid.Row="2" Header="intensity" DataContext="{Binding IntensityMap}" IsYearly="False" />

                        <Rectangle Grid.Row="3" Height="1" Fill="Gray" Margin="0,0,0,40" IsHitTestVisible="False" />

                        <TextBlock Grid.Row="4" Text="spending" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
                        <components:ReportDistributionControl Grid.Row="5" DataContext="{Binding Distribution}" />
                        <components:ReportBurnersControl Grid.Row="6" DataContext="{Binding BudgetBurners}" />
                        <components:ReportBreakdownControl Grid.Row="7" DataContext="{Binding Distribution}" />

                        <components:ReportComparisonControl Grid.Row="8" Header="comparison"
                             TrendText="vs last month" ShowProjections="True" AverageLabel="daily average" ProjectedLabel="projected total" />
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="year" DataContext="{Binding YearReport}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,20,19,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="activity" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
                        <components:ReportIntensityControl Grid.Row="1" Header="monthly intensity" DataContext="{Binding IntensityMap}" IsYearly="True" />

                        <Rectangle Grid.Row="2" Height="1" Fill="Gray" Margin="0,0,0,40" IsHitTestVisible="False" />

                        <TextBlock Grid.Row="3" Text="spending" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
                        <components:ReportDistributionControl Grid.Row="4" DataContext="{Binding Distribution}" />
                        <components:ReportBurnersControl Grid.Row="5" DataContext="{Binding BudgetBurners}" />
                        <components:ReportBreakdownControl Grid.Row="6" DataContext="{Binding Distribution}" />

                        <components:ReportComparisonControl Grid.Row="7" Header="comparison"
                             TrendText="vs last year" ShowProjections="True" AverageLabel="monthly average" ProjectedLabel="projected year" />
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="insights" DataContext="{Binding MonthReport}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,20,19,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <components:ReportRunwayControl Grid.Row="0" />

                        <Rectangle Grid.Row="1" Height="1" Fill="Gray" Margin="0,0,0,40" IsHitTestVisible="False" />

                        <components:ReportOpportunitiesControl Grid.Row="2" DataContext="{Binding SavingOpportunities}" />

                        <Rectangle Grid.Row="3" Height="1" Fill="Gray" Margin="0,0,0,40" IsHitTestVisible="False" />

                        <components:ReportSpendingPatternsControl Grid.Row="4" />
                    </Grid>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
