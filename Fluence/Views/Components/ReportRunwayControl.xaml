<UserControl
    x:Class="Fluence.Views.Components.ReportRunwayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,0,0,30">
        <TextBlock Text="financial runway" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="24" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding RunwayDays}" FontSize="96" FontWeight="Bold" Margin="0,0,8,-12" />
            <TextBlock Text="days left" FontSize="20" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,10" />
        </StackPanel>
        <TextBlock FontSize="14" Opacity="0.6" Margin="0,15,0,0" TextWrapping="Wrap">
            <Run Text="estimated until balance reaches zero. " />
            <Run Text="the financial runway is calculated by dividing your current balance by your average daily spending over the trailing 30 days. " />
            <Run Text="formula: balance / (total expenses last 30 days / 30)" FontStyle="Italic" />
        </TextBlock>
        <TextBlock Text="{Binding SavingOpportunitiesSummary}" FontSize="14" Foreground="White" Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
