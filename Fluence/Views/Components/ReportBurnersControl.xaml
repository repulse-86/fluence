<UserControl
    x:Class="Fluence.Views.Components.ReportBurnersControl"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,0,0,30">
        <TextBlock x:Name="HeaderLabel"
                   Text="{Binding Header, ElementName=root}"
                   Foreground="{ThemeResource SystemColorControlAccentBrush}"
                   FontSize="18"
                   Margin="0,0,0,10"
                   Visibility="{Binding Header, ElementName=root, Converter={StaticResource StringToVisibilityConverter}}" />
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                            <TextBlock Text="+" FontSize="18" Margin="0,5,2,0" IsHitTestVisible="False" />
                            <TextBlock Text="{Binding Trend, ConverterParameter='N2'}" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" IsHitTestVisible="False" />
                            <TextBlock Text="%" FontSize="16" Margin="2,10,0,0" IsHitTestVisible="False" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
