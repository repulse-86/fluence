<UserControl
    x:Class="Fluence.Views.Components.ReportComparisonControl"
    x:Name="controlRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#33FFFFFF" Margin="0,0,5,5" Padding="15">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="savings rate" FontSize="12" Opacity="0.8" Foreground="White" />
                    <ProgressBar Value="{Binding SavingsRate}" Foreground="#2ECC71" Height="4" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White">
                    <Run Text="{Binding SavingsRate, ConverterParameter='N2'}" FontSize="24" />
                    <Run Text="%" FontSize="14" />
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="#33FFFFFF" Margin="5,0,0,5" Padding="15">
            <Grid>
                <TextBlock Text="{Binding TrendText, ElementName=controlRoot}" FontSize="12" Opacity="0.8" VerticalAlignment="Top" Foreground="White" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TrendDirection}" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Bottom" Foreground="White" />
                    <TextBlock FontWeight="Bold" VerticalAlignment="Bottom" Foreground="White">
                        <Run Text="{Binding TrendPercent, ConverterParameter='N2'}" FontSize="24" />
                        <Run Text="%" FontSize="14" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#33FFFFFF" Margin="0,5,5,0" Padding="15">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="flow in" FontSize="12" Opacity="0.8" Foreground="White" />
                    <ProgressBar Value="{Binding FlowInPercent}" Foreground="#2ECC71" Height="4" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FlowIn, ConverterParameter='N2'}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#33FFFFFF" Margin="5,5,0,0" Padding="15">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="flow out" FontSize="12" Opacity="0.8" Foreground="White" />
                    <ProgressBar Value="{Binding FlowOutPercent}" Foreground="#E74C3C" Height="4" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FlowOut, ConverterParameter='N2'}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
