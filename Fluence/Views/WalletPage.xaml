<Page
    x:Class="Fluence.Views.WalletPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluence.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="add wallet" Style="{ThemeResource HeaderTextBlockStyle}" Margin="19,0,-100,26" TextWrapping="NoWrap" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="19,0,19,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="wallet name" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,5" IsHitTestVisible="False" />
                <TextBox Grid.Row="1" x:Name="WalletNameTextBox" PlaceholderText="e.g. main bank" />

                <TextBlock Grid.Row="2" Text="initial balance" Style="{StaticResource BodyTextBlockStyle}" Margin="0,20,0,5" IsHitTestVisible="False" />
                <TextBox Grid.Row="3" x:Name="WalletBalanceTextBox" InputScope="Number" PlaceholderText="0.00" />

                <TextBlock Grid.Row="4" x:Name="ErrorText" Text="" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="SaveAppBarButton" Icon="Save" Label="save" Click="SaveAppBarButton_Click" />
            <AppBarButton x:Name="CancelAppBarButton" Icon="Cancel" Label="cancel" Click="CancelAppBarButton_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
