<Page
    x:Class="Fluence.Views.About.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluence.Views.About"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="fluence" Style="{ThemeResource HeaderTextBlockStyle}" FontSize="80" FontWeight="Bold" Margin="19,0,-100,26" TextWrapping="NoWrap" />

        <ScrollViewer Grid.Row="1">
            <Grid Margin="19,0,19,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                    Text="version" 
                    FontSize="18" 
                    FontWeight="SemiBold"
                    Margin="0,0,0,5" 
                    Foreground="{ThemeResource SystemColorControlAccentBrush}" IsHitTestVisible="False" />
                <TextBlock Grid.Row="1"
                    Text="1.2.0.0" 
                    FontSize="18" 
                    Margin="0,0,0,30" IsHitTestVisible="False" />

                <TextBlock Grid.Row="2" Text="description"
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{ThemeResource SystemColorControlAccentBrush}" 
                           Margin="0,0,0,5" IsHitTestVisible="False" />
                <TextBlock Grid.Row="3" Text="fluence is a lightweight personal finance tracker designed for simplicity and speed. manage your daily expenses and monitor your budget health with ease."
                           FontSize="18" 
                           TextWrapping="Wrap" 
                           Margin="0,0,0,30" 
                           Opacity="0.8" IsHitTestVisible="False" />

                <TextBlock Grid.Row="4" Text="platform"
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{ThemeResource SystemColorControlAccentBrush}" 
                           Margin="0,0,0,5" IsHitTestVisible="False" />
                <TextBlock Grid.Row="5" Text="windows phone 8.1" FontSize="18" Margin="0,0,0,30" IsHitTestVisible="False" />

                <TextBlock Grid.Row="6" Text="created by"
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{ThemeResource SystemColorControlAccentBrush}" 
                           Margin="0,0,0,5" IsHitTestVisible="False" />
                <TextBlock Grid.Row="7" Text="repulse" FontSize="24" Margin="0,0,0,10" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
