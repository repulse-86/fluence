<Page
    x:Class="Fluence.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluence.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Pivot x:Name="SettingsPivot" SelectionChanged="SettingsPivot_SelectionChanged">
            <PivotItem x:Name="CategoryPivotItem" Header="categories">
                <Grid DataContext="{Binding CategoryVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="category name" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,5" />
                        <TextBox x:Name="CategoryTextBox" Text="{Binding CategoryName, Mode=TwoWay}" PlaceholderText="e.g. Transportation" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding Categories}"
                              HorizontalContentAlignment="Stretch" 
                              ShowsScrollingPlaceholders="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray"
                                        BorderThickness="0,0,0,0.5"
                                        Padding="0,14,0,14"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        Holding="CategoryBorder_Holding">
                                    <FlyoutBase.AttachedFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="edit" Click="EditCategory_Click" />
                                            <MenuFlyoutItem Text="delete" Click="DeleteCategory_Click" />
                                        </MenuFlyout>
                                    </FlyoutBase.AttachedFlyout>
                                    <TextBlock Text="{Binding Name}" FontSize="28" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="ProfilePivotItem" Header="profile">
                <Grid DataContext="{Binding ProfileVM}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Visibility="{Binding ViewVisibility}">
                                <TextBlock Text="current balance" Style="{ThemeResource ListViewItemSubheaderTextBlockStyle}" Foreground="{ThemeResource SystemColorControlAccentBrush}" FontSize="20" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InitialBalanceText, ConverterParameter='N2'}" FontSize="72" FontWeight="Thin" Margin="0,-10,0,30" TextWrapping="Wrap" />

                                <StackPanel>
                                    <StackPanel Margin="0,0,0,25">
                                        <TextBlock Text="monthly income" Style="{ThemeResource ListViewItemSubheaderTextBlockStyle}" Opacity="0.6" FontSize="20" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MonthlyIncomeText, ConverterParameter='N2'}" FontSize="34" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,25">
                                        <TextBlock Text="monthly limit" Style="{ThemeResource ListViewItemSubheaderTextBlockStyle}" Opacity="0.6" FontSize="20" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MonthlyLimitText, ConverterParameter='N2'}" FontSize="34" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,25">
                                        <TextBlock Text="payday" Style="{ThemeResource ListViewItemSubheaderTextBlockStyle}" Opacity="0.6" FontSize="20" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PaydayFormatted}" FontSize="34" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding EditVisibility}">
                                <TextBlock Text="initial balance" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,5" />
                                <TextBox x:Name="InitialBalancetextBox" Text="{Binding InitialBalanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" KeyDown="AmountTextBox_KeyDown" TextChanged="AmountTextBox_TextChanged" />
                                <TextBlock Text="{Binding InitialBalanceErrorMessage}" Foreground="Red" Margin="0,5,0,10" TextWrapping="Wrap" />

                                <TextBlock Text="monthly income" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,5" />
                                <TextBox x:Name="MonthlyIncome" Text="{Binding MonthlyIncomeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" KeyDown="AmountTextBox_KeyDown" TextChanged="AmountTextBox_TextChanged" />
                                <TextBlock Text="{Binding MonthlyIncomeErrorMessage}" Foreground="Red" Margin="0,5,0,10" TextWrapping="Wrap" />

                                <TextBlock Text="monthly limit" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,5" />
                                <TextBox x:Name="MonthlyLimit" Text="{Binding MonthlyLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" KeyDown="AmountTextBox_KeyDown" TextChanged="AmountTextBox_TextChanged" />
                                <TextBlock Text="{Binding MonthlyLimitErrorMessage}" Foreground="Red" Margin="0,5,0,10" TextWrapping="Wrap" />

                                <TextBlock Text="payday of the month" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,5" />
                                <DatePicker x:Name="Payday" Date="{Binding Payday, Mode=TwoWay}" />
                                <TextBlock Text="{Binding PaydayErrorMessage}" Foreground="Red" Margin="0,5,0,10" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="SettingsCommandBar">
            <AppBarButton x:Name="PrimaryAppBarButton" Label="save" Click="PrimaryAppBarButton_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Save" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SecondaryAppBarButton" Icon="Cancel" Label="cancel" Click="SecondaryAppBarButton_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>