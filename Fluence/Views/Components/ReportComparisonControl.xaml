<UserControl
    x:Class="Fluence.Views.Components.ReportComparisonControl"
    x:Name="controlRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Fluence.Converters">

    <Grid Margin="0,0,0,30" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#33FFFFFF" Margin="0,0,10,10" Padding="15" Height="155" Width="155">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="savings rate" FontSize="14" Opacity="0.8" Foreground="White" />
                    <ProgressBar Value="{Binding SavingsRate}" Foreground="#2ECC71" Height="4" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White">
                    <Run Text="{Binding SavingsRate, ConverterParameter='N2'}" FontSize="28" />
                    <Run Text="%" FontSize="16" />
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="#33FFFFFF" Margin="0,0,0,10" Padding="15" Height="155" Width="155">
            <Grid>
                <TextBlock Text="{Binding TrendText, ElementName=controlRoot}" FontSize="14" Opacity="0.8" VerticalAlignment="Top" Foreground="White" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TrendDirection}" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Bottom" Foreground="White" />
                    <TextBlock FontWeight="Bold" VerticalAlignment="Bottom" Foreground="White">
                        <Run Text="{Binding TrendPercent, ConverterParameter='N2'}" FontSize="28" />
                        <Run Text="%" FontSize="16" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#33FFFFFF" Margin="0,0,10,10" Padding="15" Height="155" Width="155">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="flow in" FontSize="14" Opacity="0.8" Foreground="White" />
                    <ProgressBar Value="{Binding FlowInPercent}" Foreground="#2ECC71" Height="4" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FlowIn, ConverterParameter='N2'}" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#33FFFFFF" Margin="0,0,0,10" Padding="15" Height="155" Width="155">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="flow out" FontSize="14" Opacity="0.8" Foreground="White" />
                    <ProgressBar Value="{Binding FlowOutPercent}" Foreground="#E74C3C" Height="4" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FlowOut, ConverterParameter='N2'}" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White" />
            </Grid>
        </Border>

        <!-- PROJECTIONS -->
        <Border Grid.Row="2" Grid.Column="0" Background="#33FFFFFF" Margin="0,0,10,0" Padding="15" Height="155" Width="155"
                Visibility="{Binding ShowProjections, ElementName=controlRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <TextBlock Text="{Binding AverageLabel, ElementName=controlRoot}" FontSize="14" Opacity="0.8" VerticalAlignment="Top" Foreground="White" />
                <TextBlock Text="{Binding DailyAverage, ConverterParameter='N2'}" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Background="#33FFFFFF" Margin="0,0,0,0" Padding="15" Height="155" Width="155"
                Visibility="{Binding ShowProjections, ElementName=controlRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <TextBlock Text="{Binding ProjectedLabel, ElementName=controlRoot}" FontSize="14" Opacity="0.8" VerticalAlignment="Top" Foreground="White" />
                <TextBlock Text="{Binding ProjectedTotal, ConverterParameter='N2'}" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
