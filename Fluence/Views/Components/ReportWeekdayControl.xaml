<UserControl
    x:Class="Fluence.Views.Components.ReportWeekdayControl"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,0,0,30">
        <TextBlock x:Name="HeaderLabel"
                   Text="{Binding Header, ElementName=root}"
                   Foreground="White"
                   FontSize="16"
                   Margin="0,0,0,5"
                   Visibility="{Binding Header, ElementName=root, Converter={StaticResource StringToVisibilityConverter}}" />
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#33FFFFFF" Margin="0,0,5,0" Width="44" Height="44">
                        <Grid>
                            <Rectangle Fill="White" Opacity="{Binding Intensity}" />
                            <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
